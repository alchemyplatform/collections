        "gas_payment": {
          "owner": "REPLACE_WITH_A_SUI_ADDRESS",
          "price": "1000",
          "budget": "10000000",
          "objects": []
        },
        "kind": {
          "kind": "PROGRAMMABLE_TRANSACTION",
          "programmable_transaction": {
            "inputs": [],
            "commands": []
          }
